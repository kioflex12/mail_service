# VK-значения для деплоя (скопируй в .vk-env и заполни — .vk-env в .gitignore).
# Откуда брать — см. README.md, раздел «Настройка VK».

# Ключ доступа сообщества: Управление → Настройки → Работа с API → Ключи доступа
# (права: messages / «Сообщения сообщества»).
VK_GROUP_TOKEN=

# Числовой id получателя (владельца). Узнать: открой в браузере
#   https://api.vk.com/method/users.get?user_ids=ТВОЙ_КОРОТКИЙ_АДРЕС&access_token=VK_GROUP_TOKEN&v=5.199
# В ответе поле "id".
VK_USER_ID=

# Строка подтверждения адреса сервера: Управление → Работа с API → Callback API →
# «Строка, которую должен вернуть сервер». Скопируй сюда как есть.
VK_CONFIRMATION=

# Секретный ключ Callback API (задаёшь сам в тех же настройках, латиница/цифры).
VK_SECRET=

# (необязательно) Тюнинг только для serverless — имеет приоритет над ../.env.
# MAX_THREADS поменьше: бесплатным LLM тяжело классифицировать много писем за один запрос.
# MAX_THREADS=12
# LOOKBACK_DAYS=2
# GMAIL_QUERY_EXTRA=in:anywhere
# TIMEZONE=Europe/Moscow
